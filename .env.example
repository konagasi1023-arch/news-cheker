# ============================================================
# News Cheker 環境変数設定
# このファイルを .env にコピーして各キーを入力してください
# ============================================================

# Google AI Studio の API キー
# 取得先: https://aistudio.google.com → 「APIキーを作成」
GEMINI_API_KEY=your_gemini_api_key_here

# Notion インテグレーションのシークレットキー
# 取得先: https://www.notion.so/my-integrations → 新しいインテグレーション作成
# 形式: secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_TOKEN=secret_your_notion_integration_token_here

# News Cheker データベースの ID（32文字）
# 取得方法: Notion でデータベースページを開き、URL の末尾 32 文字を使用
# 例: https://www.notion.so/myworkspace/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
#                                       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
NOTION_DATABASE_ID=your_32_char_database_id_here
